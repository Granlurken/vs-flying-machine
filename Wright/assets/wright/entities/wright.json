{
	code: "wright",
	class: "EntityWright",
	tags: ["inanimate", "vehicle"],
	weight: 120,
	attributes: {
		shouldSwivelFromMotion: false,
		speedMultiplier: 1,
		// Drivstoff: høyreklikk flyet med Aqua Vitae i bøtte/krukke/flaske. Tom tank = glideflukt
		fuel: {
			code: "game:alcoholportion",
			capacityLitres: 10,
			litresPerMinuteFullThrottle: 1
		},
		// Flymodell — fart i blokker per 1/60 s (0.34 = ~20 blokker/s). Se EntityWright.cs
		flight: {
			maxSpeed: 0.34,
			stallSpeed: 0.15,
			accel: 0.3,
			throttleRate: 0.4,
			brakeRate: 0.6,
			gravityAlongPath: 0.06,
			maxSinkRate: 0.2,
			verticalResponse: 3,
			// Nesevinkel (radianer): Space/Ctrl endrer, blir liggende
			pitchRate: 0.7,
			maxPitchUp: 0.6,
			maxPitchDown: 0.8,
			rotateLift: 0.8,
			stallNoseDrop: 1.2,
			// Krengning og sving
			maxBank: 0.7,
			bankRate: 1.5,
			bankReturn: 2.0,
			airTurnRate: 1.2,
			groundTurnRate: 0.8,
			turnResponse: 3,
			// Snu til 1/-1 hvis modellen tipper feil vei
			visualPitchSign: -1,
			visualRollSign: 1
		},
		swimmingOffsetY: 0.45,
		requiresPaddlingTool: false,
		rightClickPickup: true,
		mountAnimations: {
			idle: "sitidle",
			ready: "sitidle",
			forwards: "sitidle",
			backwards: "sitidle"
		}
	},
	hitboxSize: { x: 2, y: 1.2, z: 2 },
	behaviorConfigs: {
		passivephysicsmultibox: {
			collisionBoxes: [
				// Bare skroget kolliderer (vingene ville satt seg fast overalt). Nesa = +Z her
				{ x1: -0.6, y1: 0, z1: 0, x2: 0.6, y2: 1.4, z2: 3 },
				{ x1: -0.6, y1: 0, z1: -4, x2: 0.6, y2: 1.4, z2: 0 }
			],
			groundDragFactor: 0,
			airDragFallingFactor: 0,
			gravityFactor: 1.0
		},
		creaturecarrier: {
			seats: [
				{ apName: "PilotAP", controllable: true, bodyYawLimit: 0.5, eyeHeight: 1 },
				{ apName: "PassengerAP", bodyYawLimit: 0.8, eyeHeight: 1 }
			]
		},
		selectionboxes: {
			// Klikk setet = sett deg, klikk tanklokket med en beholder = fyll drivstoff. CargoAP venter på kista
			selectionBoxes: ["PilotAP", "PassengerAP", "FuelAP"]
		}
	},
	client: {
		size: 1,
		renderer: "Shape",
		// Generert av tools/wright_model.js — rediger skriptet, ikke JSON-en
		shape: { base: "wright:entity/wright" },
		textures: {
			"wood": { base: "game:block/wood/debarked/oak" },
			"planks": { base: "game:block/wood/planks/oak1" },
			"aged": { base: "game:block/wood/debarked/aged" },
			"fabric": { base: "game:block/cloth/linen/plain" },
			"rope": { base: "game:block/cloth/reedrope" },
			"iron": { base: "game:block/metal/sheet/iron1" },
			"chain": { base: "game:block/metal/sheet/iron3" },
			"copper": { base: "game:block/metal/sheet/copper1" },
			"leather": { base: "game:block/cloth/leather/normal" }
		},
		animations: [
			{ code: "turnLeft", animation: "turnLeft", animationSpeed: 1, easeInSpeed: 2, easeOutSpeed: 2 },
			{ code: "turnRight", animation: "turnRight", animationSpeed: 1, easeInSpeed: 2, easeOutSpeed: 2 }
		],
		behaviors: [
			{ code: "repulseagents" },
			{ code: "passivephysicsmultibox" },
			{ code: "interpolateposition" },
			{ code: "selectionboxes" },
			{ code: "creaturecarrier" }
		]
	},
	server: {
		behaviors: [
			{ code: "repulseagents" },
			{ code: "passivephysicsmultibox" },
			{ code: "selectionboxes" },
			{ code: "creaturecarrier" }
		]
	},
	sounds: { }
}
