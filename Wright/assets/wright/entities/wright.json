{
	code: "wright",
	class: "EntityWright",
	tags: ["inanimate", "vehicle"],
	weight: 120,
	attributes: {
		shouldSwivelFromMotion: false,
		speedMultiplier: 1,
		// Drivstoff: høyreklikk flyet med Aqua Vitae i bøtte/krukke/flaske. Tom tank = glideflukt
		fuel: {
			code: "game:alcoholportion",
			capacityLitres: 10,
			litresPerMinuteFullThrottle: 1
		},
		// Flymodell — fart i blokker per 1/60 s (0.34 = ~20 blokker/s). Se EntityWright.cs
		flight: {
			maxSpeed: 0.34,
			stallSpeed: 0.15,
			accel: 0.3,
			throttleRate: 0.4,
			brakeRate: 0.6,
			gravityAlongPath: 0.06,
			maxSinkRate: 0.2,
			verticalResponse: 3,
			// Nesevinkel (radianer): Space/Ctrl endrer, blir liggende
			pitchRate: 0.7,
			maxPitchUp: 0.6,
			maxPitchDown: 0.8,
			rotateLift: 0.8,
			stallNoseDrop: 1.2,
			// Krengning og sving
			maxBank: 0.7,
			bankRate: 1.5,
			bankReturn: 2.0,
			airTurnRate: 1.2,
			groundTurnRate: 0.8,
			turnResponse: 3,
			// Snu til 1/-1 hvis modellen tipper feil vei
			visualPitchSign: -1,
			visualRollSign: 1
		},
		// Propell, hjul og eksosrøyk. Snu fortegnet hvis noe spinner feil vei
		visuals: {
			propMaxRevsPerSec: 6,
			propIdleRevsPerSec: 1.5,
			propSpinSign: 1,
			wheelSpinSign: -1,
			wheelRadius: 0.38,
			// Eksosrørtoppene i modellens ramme (blokker): +X = nese, +Y = opp, +Z = høyre
			exhausts: [[2.38, 1.95, 0.335], [2.84, 1.95, 0.335]]
		},
		swimmingOffsetY: 0.45,
		requiresPaddlingTool: false,
		rightClickPickup: true,
		mountAnimations: {
			idle: "sitboatidle",
			ready: "sitboatidle",
			forwards: "sitboatidle",
			backwards: "sitboatidle"
		}
	},
	hitboxSize: { x: 2, y: 1.2, z: 2 },
	behaviorConfigs: {
		passivephysicsmultibox: {
			collisionBoxes: [
				// Bare skroget kolliderer (vingene ville satt seg fast overalt). Nesa = +Z her
				{ x1: -0.6, y1: 0, z1: 0, x2: 0.6, y2: 1.4, z2: 3 },
				{ x1: -0.6, y1: 0, z1: -4, x2: 0.6, y2: 1.4, z2: 0 }
			],
			groundDragFactor: 0,
			airDragFallingFactor: 0,
			gravityFactor: 1.0
		},
		creaturecarrier: {
			seats: [
				{ apName: "PilotAP", controllable: true, bodyYawLimit: 0.5, eyeHeight: 1 },
				{ apName: "PassengerAP", bodyYawLimit: 0.8, eyeHeight: 1 }
			]
		},
		rideableaccessories: {
			dropContentsOnDeath: true,
			// Samme rekkefølge som selectionBoxes under (vanilla-krav). Seter/tank slipper klikket videre
			wearableSlots: [
				{ code: "Pilot Seat", forCategoryCodes: [], attachmentPointCode: "PilotAP", emptyInteractPassThrough: true },
				{ code: "Passenger Seat", forCategoryCodes: [], attachmentPointCode: "PassengerAP", emptyInteractPassThrough: true },
				{ code: "Fuel", forCategoryCodes: [], attachmentPointCode: "FuelAP", emptyInteractPassThrough: true },
				// Kiste eller trunk på hylla bak piloten: Ctrl + høyreklikk med kista i hånda
				{ code: "Cargo", forCategoryCodes: ["chest", "basket", "crate"], attachmentPointCode: "CargoAP",
					stepParentTo: { "": { elementName: "CargoBox" } } }
			]
		},
		selectionboxes: {
			// Klikk setet = sett deg, klikk tank/motor med en beholder = fyll drivstoff, hylla = last
			selectionBoxes: ["PilotAP", "PassengerAP", "FuelAP", "CargoAP"]
		}
	},
	client: {
		size: 1,
		renderer: "Shape",
		// Generert av tools/wright_model.js — rediger skriptet, ikke JSON-en
		shape: { base: "wright:entity/wright" },
		textures: {
			"wood": { base: "game:block/wood/debarked/oak" },
			"planks": { base: "game:block/wood/planks/aged1" },
			"planks2": { base: "game:block/wood/planks/birch1" },
			"aged": { base: "game:block/wood/debarked/aged" },
			"fabric": { base: "game:block/cloth/linen/normal1" },
			"patch": { base: "game:block/cloth/linen/brown" },
			"patch2": { base: "game:block/cloth/burlap/sides" },
			"patch3": { base: "game:block/cloth/linen/village/darkbrown" },
			"rope": { base: "game:block/cloth/reedrope" },
			"twine": { base: "game:block/cloth/reedrope" },
			"iron": { base: "game:block/metal/sheet/iron1" },
			"rust": { base: "game:block/metal/corroded/rusty1" },
			"soot": { base: "game:block/metal/sheet/lead1" },
			"chain": { base: "game:block/metal/tarnished/chain-rust" },
			"copper": { base: "game:block/metal/sheet/copper3" },
			"leather": { base: "game:block/cloth/leather/smallstiches" },
			"pelt": { base: "game:block/cloth/pelt" },
			"blanket": { base: "game:block/cloth/wool/green2" }
		},
		animations: [
			{ code: "turnLeft", animation: "turnLeft", animationSpeed: 1, easeInSpeed: 2, easeOutSpeed: 2 },
			{ code: "turnRight", animation: "turnRight", animationSpeed: 1, easeInSpeed: 2, easeOutSpeed: 2 },
			// Rammen settes fra koden (EntityWright.UpdateSpinAnimations), derfor fart 0
			{ code: "propspin", animation: "propspin", animationSpeed: 0, weight: 1, blendMode: "Add" },
			{ code: "wheelspin", animation: "wheelspin", animationSpeed: 0, weight: 1, blendMode: "Add" }
		],
		behaviors: [
			{ code: "repulseagents" },
			{ code: "passivephysicsmultibox" },
			{ code: "interpolateposition" },
			{ code: "selectionboxes" },
			{ code: "rideableaccessories" },
			{ code: "creaturecarrier" }
		]
	},
	server: {
		behaviors: [
			{ code: "repulseagents" },
			{ code: "passivephysicsmultibox" },
			{ code: "selectionboxes" },
			{ code: "rideableaccessories" },
			{ code: "creaturecarrier" }
		]
	},
	sounds: { }
}
