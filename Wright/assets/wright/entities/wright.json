				{ x1: -0.75, y1: 0, z1: 0, x2: 0.75, y2: 0.6, z2: 1.5 },
				{ x1: -0.75, y1: 0, z1: -1.5, x2: 0.75, y2: 0.6, z2: 0 }
			],
			groundDragFactor: 0,
			airDragFallingFactor: 0,
			gravityFactor: 1.0
		},
		creaturecarrier: {
			seats: [
				{ apName: "BackSeatAP", controllable: true, bodyYawLimit: null, eyeHeight: 1 }
			]
