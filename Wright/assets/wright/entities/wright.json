{
	code: "wright",
	class: "EntityWright",
	tags: ["inanimate", "vehicle"],
	weight: 120,
	attributes: {
		shouldSwivelFromMotion: false,
		speedMultiplier: 1,
		// Flymodell — fart i blokker per 1/60 s (0.28 = ~17 blokker/s). Se EntityWright.cs
		flight: {
			maxSpeed: 0.28,
			stallSpeed: 0.15,
			accel: 0.15,
			throttleRate: 0.4,
			brakeRate: 0.6,
			gravityAlongPath: 0.12,
			maxSinkRate: 0.2,
			verticalResponse: 3,
			// Nesevinkel (radianer): Space/Ctrl endrer, blir liggende
			pitchRate: 0.7,
			maxPitchUp: 0.6,
			maxPitchDown: 0.8,
			rotateLift: 0.8,
			stallNoseDrop: 1.2,
			// Krengning og sving
			maxBank: 0.7,
			bankRate: 1.5,
			bankReturn: 2.0,
			airTurnRate: 1.2,
			groundTurnRate: 0.8,
			turnResponse: 3,
			// Snu til 1/-1 hvis modellen tipper feil vei
			visualPitchSign: -1,
			visualRollSign: 1
